    -- drop database WeGo;
	-- use WeGo;
	-- Criar Schema
	CREATE DATABASE IF NOT EXISTS wego;
USE wego;

-- Tabela: imagemUsuario
CREATE TABLE imagemUsuario (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    dados BLOB
);

-- Tabela: imagemOng
CREATE TABLE imagemOng (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    dados BLOB
);

-- Tabela: endereco
CREATE TABLE endereco (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    CEP CHAR(9),
    logradouro VARCHAR(45),
    complemento VARCHAR(45),
    numero INT,
    cidade VARCHAR(45)
);

-- Tabela: usuario
CREATE TABLE usuario (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(45),
    email VARCHAR(45) UNIQUE,
    senha VARCHAR(100),
    dataNasc DATE,
    cpf CHAR(14),
    userNovo BOOLEAN,
    fkEndereco INT,
    imagemUsuario_id INT,
    FOREIGN KEY (fkEndereco) REFERENCES endereco(id),
    FOREIGN KEY (imagemUsuario_id) REFERENCES imagemUsuario(id)
);

-- Tabela: ong
CREATE TABLE ong (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    cnpj CHAR(14),
    cpf CHAR(11),
    nome VARCHAR(45),
    razaoSocial VARCHAR(45),
    senha VARCHAR(100),
    email VARCHAR(45),
    link VARCHAR(100),
    imagemOng_id INT,
    FOREIGN KEY (imagemOng_id) REFERENCES imagemOng(id)
);

-- Tabela: pet
CREATE TABLE pet (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(45),
    idade DOUBLE,
    peso DOUBLE,
    altura DOUBLE,
    curtidas INT,
    descricao LONGTEXT,
    isLiked BOOLEAN,
    isCastrado BOOLEAN,
    isVermifugo BOOLEAN,
    isVacinado BOOLEAN,
    isAdotado BOOLEAN,
    fkOng INT,
    FOREIGN KEY (fkOng) REFERENCES ong(id)
);

-- Tabela: imagemPet
CREATE TABLE imagemPet (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    link VARCHAR(255),
    pet_id INT,
    FOREIGN KEY (pet_id) REFERENCES pet(id)
);

-- Tabela: forms
CREATE TABLE forms (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    pet_id INT,
    user_id INT,
    nome VARCHAR(100) NOT NULL,
    cpf VARCHAR(14) NOT NULL,
    email VARCHAR(100) NOT NULL,
    dataNasc DATE NOT NULL,
    telefone VARCHAR(45) NOT NULL,
    cep VARCHAR(20) NOT NULL,
    complemento VARCHAR(100),
    rua VARCHAR(100) NOT NULL,
    numero INT NOT NULL,
    cidade VARCHAR(100) NOT NULL,
    uf CHAR(2) NOT NULL,
    tipoMoradia VARCHAR(45) NOT NULL,
    aluguePodeAnimal VARCHAR(45),
    infosCasa TEXT,
    possuiPet VARCHAR(45) NOT NULL,
    infosPet TEXT,
    finalizado BOOLEAN,
    FOREIGN KEY (pet_id) REFERENCES pet(id),
    FOREIGN KEY (user_id) REFERENCES usuario(id)
);

-- Tabela: imagemForms
CREATE TABLE imagemForms (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    form_id INT,
    dados BLOB,
    FOREIGN KEY (form_id) REFERENCES forms(id)
);

-- Tabela: tags
CREATE TABLE tags (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    pet_id INT,
    tag VARCHAR(45),
    FOREIGN KEY (pet_id) REFERENCES pet(id)
);

-- Tabela: curtidas
CREATE TABLE curtidas (
    usuario_id INT NOT NULL,
    pet_id INT NOT NULL,
    dataCurtida DATETIME,
    PRIMARY KEY (usuario_id, pet_id),
    FOREIGN KEY (usuario_id) REFERENCES usuario(id),
    FOREIGN KEY (pet_id) REFERENCES pet(id)
);

-- Tabela: chat
CREATE TABLE chat (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    usuario_id INT NOT NULL,
    ong_id INT NOT NULL,
    status TINYINT,
    FOREIGN KEY (usuario_id) REFERENCES usuario(id),
    FOREIGN KEY (ong_id) REFERENCES ong(id)
);

-- Tabela: mensagens
CREATE TABLE mensagens (
    id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    chat_id INT NOT NULL,
    usuario_id INT,
    ong_id INT,
    enviadoPor VARCHAR(45),
    status VARCHAR(45),
    hora DATETIME,
    mensagem LONGTEXT,
    FOREIGN KEY (chat_id) REFERENCES chat(id)
);

SELECT id, LENGTH(dados) AS tamanhoImagem FROM imagemUsuario;

SELECT id, LENGTH(dados) AS tamanhoImagem FROM imagemOng;

SELECT * FROM endereco;

SELECT u.id, u.nome, u.email, u.dataNasc, u.cpf, e.cidade
FROM usuario u
LEFT JOIN endereco e ON u.fkEndereco = e.id;

SELECT * FROM ong;

SELECT p.id, p.nome, p.idade, p.peso, p.curtidas, o.nome AS ong_nome
FROM pet p
LEFT JOIN ong o ON p.fkOng = o.id;

SELECT id, link, pet_id FROM imagemPet;

SELECT id, nome, cpf, email, cidade, tipoMoradia, finalizado FROM forms;

SELECT id, form_id, LENGTH(dados) AS tamanhoImagem FROM imagemForms;

SELECT id, pet_id, tag FROM tags;

SELECT c.usuario_id, u.nome AS usuario_nome, c.pet_id, p.nome AS pet_nome, c.dataCurtida
FROM curtidas c
JOIN usuario u ON c.usuario_id = u.id
JOIN pet p ON c.pet_id = p.id;